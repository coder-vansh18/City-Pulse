# CityPulse Frontend Configuration

# Backend API Base URL
VITE_API_URL=http://localhost:8000

# Map Tile Provider Configuration
# 1. Default: Free Esri Canvas / OpenStreetMap (No API key needed!)
# 2. CARTO Basemaps: Sign up at https://carto.com and add your API key:
# VITE_CARTO_API_KEY=your_carto_api_key_here
#
# 3. Mapbox: Sign up at https://mapbox.com and add your access token:
# VITE_MAPBOX_TOKEN=pk.eyJ1I...
#
# 4. Custom Tile URL (Optional):
# VITE_CUSTOM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
